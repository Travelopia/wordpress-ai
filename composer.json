{
  "name": "trav-ai/wordpress-plugin",
  "type": "wordpress-plugin",
  "extra": {
    "wordpress-install-dir": "vendor/wordpress"
  },
  "require-dev": {
    "roots/wordpress": "*",
    "squizlabs/php_codesniffer": "^3.8",
    "phpstan/phpstan": "^1.10",
    "travelopia/wordpress-coding-standards": "*",
    "wp-cli/wp-cli": "^2.12",
    "phpunit/phpunit": "^9.6",
    "wp-phpunit/wp-phpunit": "^6.8",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "lint": "phpcs",
    "fix": "phpcbf",
    "test": "phpunit",
    "static-analysis": "phpstan analyse -c phpstan.neon --memory-limit=512M"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "roots/wordpress-core-installer": true,
      "php-http/discovery": false
    }
  },
  "require": {
    "wordpress/php-ai-client": "^0.1.0",
    "php-http/guzzle7-adapter": "^1.0",
    "guzzlehttp/guzzle": "^7.9",
    "http-interop/http-factory-guzzle": "^1.2"
  }
}
