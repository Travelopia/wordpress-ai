{
  "name": "travelopia/wordpress-ai",
  "type": "wordpress-plugin",
  "autoload": {
    "psr-4": {
      "Travelopia\\WordPress_AI\\": "./inc"
    }
  },
  "require": {
    "php": "^8.2",
    "wordpress/php-ai-client": "^0.1.0",
    "php-http/guzzle7-adapter": "^1.0",
    "guzzlehttp/guzzle": "^7.9",
    "http-interop/http-factory-guzzle": "^1.2"
  },
  "require-dev": {
    "roots/wordpress": "*",
    "phpstan/phpstan": "^1.10",
    "travelopia/wordpress-coding-standards": "^2",
    "wp-cli/wp-cli": "^2.12",
    "phpunit/phpunit": "^9.6",
    "wp-phpunit/wp-phpunit": "^6.8",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "lint": "phpcs",
    "format": "php-cs-fixer fix --dry-run --using-cache=no",
    "format-fix": "php-cs-fixer fix",
    "test": "phpunit",
    "static-analysis": "phpstan analyse -c phpstan.neon --memory-limit=512M"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "roots/wordpress-core-installer": true,
      "php-http/discovery": false
    }
  }
}
