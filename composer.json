{
  "name": "travelopia/wordpress-ai",
  "type": "wordpress-plugin",
  "autoload": {
    "psr-4": {
      "Travelopia\\WordPress_AI\\": "./inc",
      "Travelopia\\WordPress_AI\\Tests\\": "./.tests/php/tests",
      "Aysnc\\WordPress\\PhpAiClientBedrock\\": "./inc/Providers/Bedrock"
    }
  },
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "roots/wordpress": "*",
    "phpstan/phpstan": "^2.1.38",
    "travelopia/wordpress-coding-standards": "^2",
    "wp-cli/wp-cli": "^v2.12.0",
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "lint": "phpcs",
    "format": "php-cs-fixer fix --dry-run --using-cache=no",
    "format-fix": "php-cs-fixer fix",
    "test": "phpunit",
    "static-analysis": "phpstan analyse -c phpstan.neon --memory-limit=512M"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": false,
      "roots/wordpress-core-installer": true
    }
  }
}
