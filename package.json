{
  "name": "trav-ai-wordpress",
  "version": "0.1.0",
  "description": "AI-powered alt text generation for WordPress.",
  "scripts": {
    "build": "npm run clear-assets && webpack --config ./webpack.config.js --mode production --env=production",
    "dev": "npm run clear-assets && webpack --config ./webpack.config.js --mode production --env=development --watch",
    "clear-assets": "rm -rf ./dist",
    "lint": "npm run lint:js && npm run lint:scss && npm run lint:php",
    "lint:js": "eslint src webpack.config.js",
    "lint:scss": "stylelint src",
    "lint:php": "composer run lint",
    "lint-test": "npm run lint && npm run static-analysis:php",
    "static-analysis:php": "composer static-analysis"
  },
  "author": "TravAI Team",
  "license": "MIT",
  "devDependencies": {
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.4",
    "sass": "^1.92.1",
    "sass-loader": "^16.0.5",
    "ts-loader": "^9.5.4",
    "webpack": "^5.101.3"
  }
}
