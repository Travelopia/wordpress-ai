<phpunit
	bootstrap=".tests/php/bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
>
	<testsuites>
		<testsuite name="wordpress-ai-tests">
			<directory suffix="Test.php">.tests/php/tests</directory>
		</testsuite>
	</testsuites>
</phpunit>
